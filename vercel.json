      "permanent": true
    },
    {
      "source": "/agentes-de-ia",
      "destination": "/#ai-search-context",
      "permanent": true
    },
    {
      "source": "/sistemas-web-sob-medida",
      "destination": "/#ai-search-context",
      "permanent": true
    },
    {
      "source": "/sites-profissionais",
      "destination": "/#seo-organico",
      "permanent": true
    },
    {
      "source": "/seo-trafego-organico",
      "destination": "/#seo-organico",
      "permanent": true
    },
    {
      "source": "/contrate-me",
      "destination": "/#proximos-passos",
      "permanent": true
    },
    {
      "source": "/freelancer-desenvolvedor-full-stack",
      "destination": "/#proximos-passos",
